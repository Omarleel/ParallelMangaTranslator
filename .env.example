GROQ_API_KEY=
DEEPL_API_KEY=
# Calidad / rendimiento profesional
PMT_CONFIG=config.yaml
PMT_SOURCE_LANG=Japonés
PMT_TARGET_LANG=Español
PMT_TRANSLATION_METHOD=LLM
PMT_INPUT_DIR=Dataset
PMT_BATCH_SIZE=8
PMT_PARALLEL=false
PMT_CACHE=1
PMT_CACHE_DIR=.cache
PMT_BUBBLE_DETECTION=1
PMT_BUBBLE_FILL=1
PMT_INPAINT_MODE=auto
PMT_BUBBLE_FILL_EDGE_MARGIN=6
PMT_BUBBLE_FILL_FEATHER=1.0
PMT_ONOMATOPOEIA_MODE=translate
PMT_TRANSLATE_ONOMATOPOEIA=1
PMT_EXPORT_PDF=true
PMT_EXPORT_CBZ=false
PMT_SKIP_PDF=0
PMT_GLOSSARY=
